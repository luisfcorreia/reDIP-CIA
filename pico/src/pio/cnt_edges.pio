; CNT Edge Detection PIO
; Detects rising and falling edges of CNT input
; Output: 1 bit to FIFO (1=rising, 0=falling)

.program cnt_edges

cnt_loop:
    wait 0 gpio 41          ; Wait CNT low
    wait 1 gpio 41          ; Wait CNT rising edge
    set x, 1                ; Push 1 for rising edge
    push noblock

cnt_fall:
    wait 1 gpio 41          ; Wait CNT high
    wait 0 gpio 41          ; Wait CNT falling edge
    set x, 0                ; Push 0 for falling edge
    push noblock
    jmp cnt_loop

% c-sdk {
#include "hardware/gpio.h"
#include "cnt_edges.pio.h"

void cnt_edges_program_init(PIO pio, uint sm, uint offset) {
    gpio_init(41);
    gpio_set_dir(41, GPIO_IN);

    pio_sm_config c = cnt_edges_program_get_default_config(offset);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
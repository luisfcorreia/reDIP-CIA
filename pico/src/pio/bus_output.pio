; CIA Bus Data Output PIO
; SM1: Drive data bus during read cycles ← TX FIFO

.program bus_output

output_loop:
    wait 1 gpio 16          ; Wait PHI2 high
    out pins, 8             ; Output data to GPIO0-7
    jmp output_loop

% c-sdk {
#include "hardware/gpio.h"
#include "bus_output.pio.h"

void bus_output_program_init(PIO pio, uint sm, uint offset) {
    for (int i = 0; i < 8; i++) {
        gpio_init(i);
        gpio_set_dir(i, GPIO_OUT);
    }

    pio_sm_config c = bus_output_program_get_default_config(offset);
    sm_config_set_out_pins(&c, 0, 8);
    sm_config_set_out_shift(&c, true, false, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}